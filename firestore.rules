rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // MUMBAI SPICE: NAVRATRI EDITION SECURITY RULES
    // 1. Visitors can ONLY READ (public view-only)
    // 2. Only the authenticated stall owner/admin can write
    
    match /stallConfig/{document=**} {
      // Anyone can read the menu, combos, and fest details
      allow read: if true;
      
      // Only the authenticated admin user can modify stall data
      // Option A: Any authenticated admin from your Firebase project
      allow write: if request.auth != null;
      
      // Option B (Strict): Lock strictly to the owner's email:
      // allow write: if request.auth != null && request.auth.token.email == "admin@mumbaispice.com";
      
      // Option C (Strict UID): Lock to exact Firebase Auth UID:
      // allow write: if request.auth != null && request.auth.uid == "YOUR_ADMIN_UID_HERE";
    }

    // Fallback: Deny writes elsewhere
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
